# Copy to .env and fill in real values. Never commit the resulting .env.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=auth_db

# Require TLS to the database. Turn on for any managed Postgres.
DB_SSL=false

# Run pending migrations on boot. Leave false and run `npm run migration:run`
# as a release step; several instances starting at once would otherwise race.
DB_RUN_MIGRATIONS=false

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
# Required in production. Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-in-production
JWT_REFRESH_EXPIRATION=7d

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# bcrypt work factor. 12 is the OWASP baseline; lower only for local speed.
BCRYPT_ROUNDS=12

# Consecutive failed logins before an account is locked, and for how long (ms).
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MS=900000

# Publish the Swagger UI at /api/docs. Defaults to off in production, since it
# lists every route an attacker would otherwise have to discover.
SWAGGER_ENABLED=true

# ---------------------------------------------------------------------------
# CORS — comma-separated list of allowed origins
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# Rate limiting — requests per window, and window length in ms
# ---------------------------------------------------------------------------
THROTTLE_TTL=60000
THROTTLE_LIMIT=20
